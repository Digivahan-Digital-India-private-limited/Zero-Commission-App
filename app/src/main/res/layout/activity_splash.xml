<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Splash">
    <?xml version="1.0" encoding="utf-8"?>

        <!-- Top Right Decorative Dot Grid -->
        <ImageView
            android:id="@+id/ivDotGrid"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:layout_marginTop="56dp"
            android:layout_marginEnd="28dp"
            android:contentDescription="@string/cd_decorative"
            android:importantForAccessibility="no"
            android:src="@drawable/bg_dot_grid"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Center Anchor for Branding and Concentric Rings -->
        <View
            android:id="@+id/centerAnchor"
            android:layout_width="1dp"
            android:layout_height="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.44" />

        <!-- Background Ripple Rings -->
        <View
            android:id="@+id/rippleRingOuter"
            android:layout_width="390dp"
            android:layout_height="390dp"
            android:background="@drawable/bg_ripple_ring_large"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@id/centerAnchor"
            app:layout_constraintEnd_toEndOf="@id/centerAnchor"
            app:layout_constraintStart_toStartOf="@id/centerAnchor"
            app:layout_constraintTop_toTopOf="@id/centerAnchor" />

        <View
            android:id="@+id/rippleRingMiddle"
            android:layout_width="290dp"
            android:layout_height="290dp"
            android:background="@drawable/bg_ripple_ring_medium"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@id/centerAnchor"
            app:layout_constraintEnd_toEndOf="@id/centerAnchor"
            app:layout_constraintStart_toStartOf="@id/centerAnchor"
            app:layout_constraintTop_toTopOf="@id/centerAnchor" />

        <View
            android:id="@+id/rippleRingInner"
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:background="@drawable/bg_ripple_ring_small"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@id/centerAnchor"
            app:layout_constraintEnd_toEndOf="@id/centerAnchor"
            app:layout_constraintStart_toStartOf="@id/centerAnchor"
            app:layout_constraintTop_toTopOf="@id/centerAnchor" />

        <!-- Floating Icon 1: Top-Left (Bank) -->
        <FrameLayout
            android:id="@+id/flFloatingBank"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="36dp"
            android:layout_marginBottom="160dp"
            android:background="@drawable/bg_circle_white_elevated"
            android:elevation="6dp"
            app:layout_constraintBottom_toTopOf="@id/centerAnchor"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/ivFloatingBank"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_bank_icon"
                android:src="@drawable/ic_bank" />
        </FrameLayout>

        <!-- Floating Icon 2: Top-Right (Shield) -->
        <FrameLayout
            android:id="@+id/flFloatingShield"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="48dp"
            android:layout_marginBottom="130dp"
            android:background="@drawable/bg_circle_white_elevated"
            android:elevation="6dp"
            app:layout_constraintBottom_toTopOf="@id/centerAnchor"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/ivFloatingShield"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_shield_icon"
                android:src="@drawable/ic_shield_check" />
        </FrameLayout>

        <!-- Floating Icon 3: Mid-Left (Percentage) -->
        <FrameLayout
            android:id="@+id/flFloatingPercent"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_circle_white_elevated"
            android:elevation="6dp"
            app:layout_constraintBottom_toBottomOf="@id/centerAnchor"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/ivFloatingPercent"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_percent_icon"
                android:src="@drawable/ic_percent" />
        </FrameLayout>

        <!-- Floating Icon 4: Mid-Right (Document) -->
        <FrameLayout
            android:id="@+id/flFloatingDocument"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_circle_white_elevated"
            android:elevation="6dp"
            app:layout_constraintBottom_toBottomOf="@id/centerAnchor"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/ivFloatingDocument"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_document_icon"
                android:src="@drawable/ic_document" />
        </FrameLayout>

        <!-- Central Branding Container -->
        <LinearLayout
            android:id="@+id/llCenterBranding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/centerAnchor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/centerAnchor">

            <!-- Logo Row: Zero in Blue Circle + Commission -->
            <LinearLayout
                android:id="@+id/llLogoRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- "Zero" in blue gradient circle -->
                <FrameLayout
                    android:id="@+id/flZeroCircle"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_logo_circle"
                    android:elevation="4dp">

                    <TextView
                        android:id="@+id/tvZeroText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/brand_name_zero"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- "Commission" Text -->
                <TextView
                    android:id="@+id/tvCommissionText"
                    style="@style/TextAppearance.ZeroCommission.BrandTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/brand_name_commission" />
            </LinearLayout>

            <!-- Tagline: Divider - Apka Loan • Apka Fayda - Divider -->
            <LinearLayout
                android:id="@+id/llTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="32dp"
                    android:layout_height="1dp"
                    android:background="@color/divider" />

                <TextView
                    android:id="@+id/tvTagline"
                    style="@style/TextAppearance.ZeroCommission.Tagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:text="@string/splash_tagline" />

                <View
                    android:layout_width="32dp"
                    android:layout_height="1dp"
                    android:background="@color/divider" />
            </LinearLayout>

        </LinearLayout>

        <!-- Main Headline: India's Trusted Loan Marketplace -->
        <TextView
            android:id="@+id/tvMainHeadline"
            style="@style/TextAppearance.ZeroCommission.Headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="24dp"
            android:gravity="center"
            android:text="@string/splash_headline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llCenterBranding" />

        <!-- Supporting Text: Compare. Apply. Save More. -->
        <TextView
            android:id="@+id/tvSupportingText"
            style="@style/TextAppearance.ZeroCommission.Supporting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="24dp"
            android:gravity="center"
            android:text="@string/splash_supporting"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvMainHeadline" />

        <!-- Bottom Features Section (4 items row) -->
        <LinearLayout
            android:id="@+id/llFeatureRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="44dp"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="4"
            app:layout_constraintBottom_toTopOf="@id/llLoadingSection"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Feature 1: 50+ Banks & NBFCs -->
            <LinearLayout
                android:id="@+id/llFeature1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="@dimen/feature_icon_size"
                    android:layout_height="@dimen/feature_icon_size"
                    android:background="@drawable/bg_feature_pill"
                    android:elevation="3dp">

                    <ImageView
                        android:layout_width="@dimen/feature_icon_inner"
                        android:layout_height="@dimen/feature_icon_inner"
                        android:layout_gravity="center"
                        android:contentDescription="@string/cd_bank_icon"
                        android:src="@drawable/ic_bank" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvFeature1Title"
                    style="@style/TextAppearance.ZeroCommission.FeatureTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/feature_1_title"
                    android:textColor="@color/primary" />

                <TextView
                    android:id="@+id/tvFeature1Subtitle"
                    style="@style/TextAppearance.ZeroCommission.FeatureSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="@string/feature_1_subtitle" />
            </LinearLayout>

            <!-- Feature 2: 100% Paperless -->
            <LinearLayout
                android:id="@+id/llFeature2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="@dimen/feature_icon_size"
                    android:layout_height="@dimen/feature_icon_size"
                    android:background="@drawable/bg_feature_pill"
                    android:elevation="3dp">

                    <ImageView
                        android:layout_width="@dimen/feature_icon_inner"
                        android:layout_height="@dimen/feature_icon_inner"
                        android:layout_gravity="center"
                        android:contentDescription="@string/cd_shield_icon"
                        android:src="@drawable/ic_shield_check" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvFeature2Title"
                    style="@style/TextAppearance.ZeroCommission.FeatureTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/feature_2_title" />

                <TextView
                    android:id="@+id/tvFeature2Subtitle"
                    style="@style/TextAppearance.ZeroCommission.FeatureSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="@string/feature_2_subtitle" />
            </LinearLayout>

            <!-- Feature 3: Quick Approval -->
            <LinearLayout
                android:id="@+id/llFeature3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="@dimen/feature_icon_size"
                    android:layout_height="@dimen/feature_icon_size"
                    android:background="@drawable/bg_feature_pill"
                    android:elevation="3dp">

                    <ImageView
                        android:layout_width="@dimen/feature_icon_inner"
                        android:layout_height="@dimen/feature_icon_inner"
                        android:layout_gravity="center"
                        android:contentDescription="@string/cd_lightning_icon"
                        android:src="@drawable/ic_lightning" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvFeature3Title"
                    style="@style/TextAppearance.ZeroCommission.FeatureTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/feature_3_title" />

                <TextView
                    android:id="@+id/tvFeature3Subtitle"
                    style="@style/TextAppearance.ZeroCommission.FeatureSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="@string/feature_3_subtitle" />
            </LinearLayout>

            <!-- Feature 4: Lowest Interest Rates -->
            <LinearLayout
                android:id="@+id/llFeature4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="@dimen/feature_icon_size"
                    android:layout_height="@dimen/feature_icon_size"
                    android:background="@drawable/bg_feature_pill"
                    android:elevation="3dp">

                    <ImageView
                        android:layout_width="@dimen/feature_icon_inner"
                        android:layout_height="@dimen/feature_icon_inner"
                        android:layout_gravity="center"
                        android:contentDescription="@string/cd_percent_icon"
                        android:src="@drawable/ic_percent" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvFeature4Title"
                    style="@style/TextAppearance.ZeroCommission.FeatureTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/feature_4_title" />

                <TextView
                    android:id="@+id/tvFeature4Subtitle"
                    style="@style/TextAppearance.ZeroCommission.FeatureSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="@string/feature_4_subtitle" />
            </LinearLayout>

        </LinearLayout>

        <!-- Bottom Loading Section -->
        <LinearLayout
            android:id="@+id/llLoadingSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="36dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tvLoading"
                style="@style/TextAppearance.ZeroCommission.Loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/splash_loading" />

            <ProgressBar
                android:id="@+id/pbLoading"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="@dimen/progress_width"
                android:layout_height="@dimen/progress_height"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/bg_progress_bar" />
        </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>